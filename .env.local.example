# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Qloo hackathon key (sent as the X-Api-Key header)
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com

# Gemini key for the agent (Vercel AI SDK reads this name automatically)
GOOGLE_GENERATIVE_AI_API_KEY=

# true = use built-in sample data instead of calling Qloo
USE_MOCK_QLOO=true
